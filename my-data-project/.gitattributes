# Auto detect text files and normalize line endings
* text=auto

# Python files
*.py text diff=python eol=lf
*.pyw text diff=python eol=lf
*.pyi text diff=python eol=lf
*.ipynb text eol=lf

# Data files
*.csv text eol=lf
*.tsv text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.sql text eol=lf

# Documentation
*.md text diff=markdown eol=lf
*.rst text eol=lf
*.txt text eol=lf

# Binary files
*.pdf binary
*.duckdb binary
*.db binary
*.sqlite binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary

# Vector graphics
*.svg text eol=lf

# Scripts
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Git files
.gitattributes text eol=lf
.gitignore text eol=lf
.gitkeep text eol=lf
