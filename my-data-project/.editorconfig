# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

# Python files
[*.{py,pyw,pyi}]
indent_style = space
indent_size = 4
max_line_length = 88  # Black default

# Jupyter notebooks
[*.ipynb]
indent_style = space
indent_size = 4

# YAML files
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# Data files
[*.{json,sql}]
indent_style = space
indent_size = 2

# Windows scripts
[*.{cmd,bat,ps1}]
end_of_line = crlf